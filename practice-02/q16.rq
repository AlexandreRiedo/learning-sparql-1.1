PREFIX : <http://cui.unig.ch/bda/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?ComposantIRI (COUNT(DISTINCT ?ProduitIRI) AS ?DependentProduitCount)
WHERE {
    ?ComposantIRI a :Composant .

    ?ProduitIRI a :Produit ;
        :utilise/(:contient|:utilise)* ?ComposantIRI .
}
GROUP BY ?ComposantIRI
HAVING (COUNT(DISTINCT ?ProduitIRI) >= 2)
ORDER BY DESC(?DependentProduitCount)