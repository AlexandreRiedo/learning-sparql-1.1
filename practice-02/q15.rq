PREFIX : <http://cui.unig.ch/bda/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?FournisseurLabel (COUNT(DISTINCT ?ProduitIRI) AS ?dependentProduits)
WHERE {
    ?FournisseurIRI a :Fournisseur ;
        rdfs:label ?FournisseurLabel ;
        ^ :fournisseur / :contient * ?ComposantIRI .

    ?ProduitIRI :utilise + ?ComposantIRI .
}

GROUP BY ?FournisseurLabel
ORDER BY DESC (COUNT(DISTINCT ?ProduitIRI))