PREFIX : <http://cui.unig.ch/bda/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?ComposantIRI
WHERE {
    # OPTION A
    ?ComposantIRI a :Composant .
    ?ComposantIRI :fournisseur :arm .

    # OPTION B
    VALUES ?FournisseurIRI { :arm }
    ?ComposantIRI a :Composant ;
        :fournisseur ?FournisseurIRI .
}
ORDER BY ?ComposantIRI