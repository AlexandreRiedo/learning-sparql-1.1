PREFIX : <http://cui.unig.ch/bda/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?ProduitIRI
WHERE {
    ?ProduitIRI a :Produit ;
        :utilise / (:contient | :utilise) * ?ComposantIRI .

    FILTER NOT EXISTS {
        {
            SELECT ?ArmComposantIRI
            WHERE {
                ?ArmComposantIRI :fournisseur :arm
            }
        }

        FILTER NOT EXISTS {
            ?ProduitIRI :utilise / (:contient | :utilise) * ?ArmComposantIRI .
        }
    }
}